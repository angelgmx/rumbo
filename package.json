{
  "name": "rumbo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rumbo/desktop dev",
    "build": "pnpm --filter @rumbo/desktop build",
    "test": "pnpm --filter @rumbo/core test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.5.2"
}
