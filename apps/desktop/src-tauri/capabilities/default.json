{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal. Los ficheros solo se pueden tocar dentro de la carpeta del vault que elige el usuario. La red, solo con la URL del proveedor de IA que pone el usuario en Ajustes. La base de datos es la de la app, en su carpeta de datos.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "store:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "fs:allow-remove",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "obsidian://*"
        }
      ]
    }
  ]
}
